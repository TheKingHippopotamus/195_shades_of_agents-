---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DepartmentCard from '../../components/DepartmentCard.astro';
import { DEPARTMENTS, DEPARTMENT_COLORS } from '../../lib/constants';
import agents from '../../data/agents.json';

// Compute descriptions for each department
const deptDescriptions: Record<string, string> = {};
for (const dept of DEPARTMENTS) {
  const deptAgents = agents.filter(a => a.department === dept.name);
  const tierCounts: Record<string, number> = {};
  for (const a of deptAgents) {
    const label = a.tierLabel.replace(/Tier \d+ — /, '');
    tierCounts[label] = (tierCounts[label] || 0) + 1;
  }
  const summary = Object.entries(tierCounts)
    .map(([label, count]) => `${count} ${label}`)
    .join(', ');
  deptDescriptions[dept.name] = summary;
}

function deptSlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '');
}
---

<BaseLayout title="Departments" description="Explore all 20 departments of the NEXUS AI agency, from Executive Leadership to Special Agents.">
  <!-- Hero -->
  <section class="gradient-hero relative overflow-hidden pt-28 pb-16">
    <div class="absolute inset-0 gradient-mesh" aria-hidden="true"></div>
    <div class="relative container-content">
      <h1 class="text-h1 font-bold text-signal mb-4">20 Departments</h1>
      <p class="text-body-lg text-mist max-w-2xl">
        Every department is staffed with specialized AI agents working in concert —
        from engineering and design to legal, security, and governance.
      </p>
    </div>
  </section>

  <!-- Departments Grid -->
  <section class="py-12 md:py-16">
    <div class="container-content">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {DEPARTMENTS.map((dept) => (
          <a href={`${import.meta.env.BASE_URL}departments/${deptSlug(dept.name)}/`} class="block no-underline">
            <DepartmentCard
              number={dept.number}
              name={dept.name}
              agentCount={dept.agentCount}
              range={dept.range}
              description={deptDescriptions[dept.name]}
            />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
