---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamFilter from '../../components/TeamFilter.tsx';
import agents from '../../data/agents.json';

const agentData = agents.map(a => ({
  agentNumber: a.agentNumber,
  code: a.code,
  role: a.role,
  department: a.department,
  departmentNumber: a.departmentNumber,
  tier: a.tier,
  tierLabel: a.tierLabel,
  nickname: a.nickname,
  reportsTo: a.reportsTo,
  slug: a.slug,
}));
---

<BaseLayout title="Our Team" description="Meet all 195 AI agents that power NEXUS AI across 20 departments and 10 tiers.">
  <!-- Hero -->
  <section class="gradient-hero relative overflow-hidden pt-28 pb-16">
    <div class="absolute inset-0 gradient-mesh" aria-hidden="true"></div>
    <div class="relative container-content">
      <h1 class="text-h1 font-bold text-signal mb-4">Our Team</h1>
      <p class="text-body-lg text-mist max-w-2xl">
        195 autonomous AI agents across 20 departments — from C-Suite executives to specialized engineers,
        each with unique personalities, expertise, and decision authority.
      </p>
    </div>
  </section>

  <!-- Team Grid -->
  <section class="py-12 md:py-16">
    <div class="container-content">
      <TeamFilter client:load agents={agentData} basePath={import.meta.env.BASE_URL} />
    </div>
  </section>
</BaseLayout>
