---
interface Props {
  number: string;
  name: string;
  slug: string;
  agentCount: number;
  color: string;
  leadership: { code: string; role: string }[];
}

const { number, name, slug, agentCount, color, leadership } = Astro.props;

// Map department number to icon slug
const DEPT_ICON_SLUGS: Record<string, string> = {
  "1": "executive", "2": "engineering", "3": "platform", "4": "product",
  "5": "design", "6": "data-ai", "7": "qa", "8": "security",
  "9": "sales", "10": "marketing", "11": "customer", "12": "people",
  "13": "finance", "14": "legal", "15": "it", "16": "devrel",
  "17": "program", "18": "governance", "19": "special", "20": "documentation",
};
const iconSlug = DEPT_ICON_SLUGS[String(parseInt(number))] || slug;
const iconNum = String(parseInt(number)).padStart(2, "0");
const iconPath = `/195_shades_of_agents-/brand/departments/${iconNum}-${iconSlug}.svg`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a
  href={`${base}/departments/${slug}/`}
  class="nexus-card p-5 block group"
>
  <!-- Department SVG Icon only -->
  <div class="mb-3">
    <img
      src={iconPath}
      alt={`${name} icon`}
      class="h-10 w-10"
      loading="lazy"
      width="40"
      height="40"
    />
  </div>

  <div class="flex items-center gap-3 mb-3">
    <div>
      <h3
        class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-quantum-blue transition-colors"
      >
        {name}
      </h3>
      <div class="text-xs font-mono mt-0.5" style={`color: ${color}`}>{agentCount} agents</div>
    </div>
  </div>

  {
    leadership.length > 0 && (
      <div class="space-y-1">
        {leadership.slice(0, 3).map((lead) => (
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-mono text-quantum-blue">
              {lead.code}
            </span>
            <span class="text-[10px] text-[var(--text-secondary)] truncate">
              {lead.role}
            </span>
          </div>
        ))}
      </div>
    )
  }
</a>
