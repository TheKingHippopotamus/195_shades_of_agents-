---
import { getTierColor } from "../../lib/tier-labels";

interface Props {
  number: number;
  label: string;
}

const { number, label } = Astro.props;
const color = getTierColor(number);
---

<span
  class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full font-medium"
  style={`background-color: ${color}15; color: ${color}; border: 1px solid ${color}30`}
>
  <span class="font-mono">T{number}</span>
  <span class="hidden sm:inline">{label}</span>
</span>
