// ─────────────────────────────────────────────────────────────────────────────
// AGGREGATE STATS
// ─────────────────────────────────────────────────────────────────────────────
const totalTools = departments.reduce((sum, d) => sum + d.tech.length, 0);
const adoptCount = departments.reduce((sum, d) => sum + d.tech.filter(t => t.status === "ADOPT").length, 0);
const trialCount = departments.reduce((sum, d) => sum + d.tech.filter(t => t.status === "TRIAL").length, 0);
const deptsCount = 20;

// Radar bar data (tool count per dept, capped for visual width)
const radarMax = Math.max(...departments.map(d => d.tech.length));
---

<PageLayout
  title="Tech Arsenal"
  description="Every tool, framework, and platform our 195 agents deploy — organized by department, rated by maturity."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 lg:py-16">

    <!-- ──────────────────────────────────────────────────────────────────────
         BREADCRUMB
         ────────────────────────────────────────────────────────────────────── -->
    <nav class="mb-8 text-sm text-[var(--text-secondary)]">
      <a href={`${base}/`} class="hover:text-quantum-blue transition-colors">Home</a>
      <span class="mx-2 opacity-40">/</span>
      <a href={`${base}/capabilities/`} class="hover:text-quantum-blue transition-colors">Capabilities</a>
      <span class="mx-2 opacity-40">/</span>
      <span class="text-[var(--text-primary)]">Tech Arsenal</span>
    </nav>

    <!-- ──────────────────────────────────────────────────────────────────────
         HERO
         ────────────────────────────────────────────────────────────────────── -->
    <div class="relative mb-14">
      <!-- Background accent -->
      <div class="absolute -top-8 -left-8 w-96 h-40 opacity-10 pointer-events-none" style="background: radial-gradient(ellipse, #00D9FF, transparent 70%); filter: blur(60px);"></div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface)] text-[10px] font-bold text-quantum-blue tracking-widest uppercase mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-quantum-blue animate-pulse"></span>
        NEXUS AI Technology Radar
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[var(--text-primary)] leading-tight tracking-tight mb-5">
        The NEXUS AI<br />
        <span class="bg-gradient-to-r from-quantum-blue via-neon-purple to-neon-pink bg-clip-text text-transparent">Tech Arsenal</span>
      </h1>
      <p class="text-lg text-[var(--text-secondary)] max-w-2xl leading-relaxed mb-8">
        Every tool, framework, and platform our 195 agents deploy — organized by department, rated by maturity.
      </p>

      <!-- Stat chips -->
      <div class="flex flex-wrap gap-3">
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black text-quantum-blue">{totalTools}</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">Total Tools</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black text-neon-purple">{deptsCount}</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">Departments</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black" style="color: #10B981;">{adoptCount}</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">ADOPT tools</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black" style="color: #F59E0B;">{trialCount}</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">TRIAL tools</span>
        </div>
      </div>
    </div>

    <!-- ──────────────────────────────────────────────────────────────────────
         STATUS LEGEND
         ────────────────────────────────────────────────────────────────────── -->
    <div class="mb-12 p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
      <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">Status Legend</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {Object.entries(statuses).map(([key, s]) => (
          <div class="flex items-center gap-3">
            <div
              class="flex-shrink-0 w-9 h-9 rounded-lg flex items-center justify-center text-xs font-black"
              style={`background: ${s.color}20; color: ${s.color}; border: 1.5px solid ${s.color}40;`}
            >
              {s.letter}
            </div>
            <div>
              <div class="text-sm font-bold" style={`color: ${s.color};`}>{s.label}</div>
              <div class="text-[11px] text-[var(--text-muted)]">{s.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ──────────────────────────────────────────────────────────────────────
         RADAR OVERVIEW — CSS BAR CHART
         ────────────────────────────────────────────────────────────────────── -->
    <div class="mb-14 p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
      <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest mb-5">Radar Overview — Tools per Department</p>
      <div class="space-y-2.5">
        {departments.map((d) => {
          const pct = Math.round((d.tech.length / radarMax) * 100);
          return (
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded flex items-center justify-center text-[9px] font-black flex-shrink-0"
                   style={`background: ${d.color}20; color: ${d.color};`}>
                {d.num.replace(/[ab]/, "")}
              </div>
              <div class="w-40 text-[11px] text-[var(--text-secondary)] truncate flex-shrink-0">{d.name}</div>
              <div class="flex-1 h-2 rounded-full bg-[var(--bg-elevated)] overflow-hidden">
                <div
                  class="h-full rounded-full"
                  style={`width: ${pct}%; background: linear-gradient(90deg, ${d.color}, ${d.color}80);`}
                ></div>
              </div>
              <div class="text-[11px] font-mono font-bold w-7 text-right flex-shrink-0" style={`color: ${d.color};`}>
                {d.tech.length}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- ──────────────────────────────────────────────────────────────────────
         DEPARTMENT SECTIONS
         ────────────────────────────────────────────────────────────────────── -->
    <div class="space-y-8">
      {departments.map((dept) => {
        const deptAdopt = dept.tech.filter(t => t.status === "ADOPT").length;
        return (
          <section
            class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] overflow-hidden"
            style={`border-left: 4px solid ${dept.color};`}
          >
            <!-- Department header -->
            <div class="px-6 py-4 flex items-center gap-4 border-b border-[var(--border-color)]"
                 style={`background: ${dept.color}08;`}>
              <!-- Number badge -->
              <div
                class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center text-xs font-black"
                style={`background: ${dept.color}20; color: ${dept.color}; border: 1.5px solid ${dept.color}40;`}
              >
                {dept.num.replace(/[ab]/, "")}
              </div>
              <!-- Name + meta -->
              <div class="flex-1 min-w-0">
                <h2 class="text-base font-bold text-[var(--text-primary)] leading-tight">{dept.name}</h2>
                <p class="text-xs text-[var(--text-muted)]">{dept.agents} agents &middot; {dept.tech.length} tools &middot; {deptAdopt} adopted</p>
              </div>
              <!-- Adopt indicator -->
              <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full"
                   style={`background: ${dept.color}15; border: 1px solid ${dept.color}30;`}>
                <span class="w-1.5 h-1.5 rounded-full" style={`background: ${dept.color};`}></span>
                <span class="text-[11px] font-bold" style={`color: ${dept.color};`}>{dept.tech.length} tools</span>
              </div>
            </div>

            <!-- Tech chip grid -->
            <div class="p-5 flex flex-wrap gap-2">
              {dept.tech.map((item) => {
                const s = statuses[item.status];
                return (
                  <div
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border transition-all"
                    style={`background: ${dept.color}08; border-color: ${dept.color}20;`}
                    title={item.note ?? ""}
                  >
                    <!-- Tech name -->
                    <span class="text-xs font-mono font-semibold text-[var(--text-primary)]">{item.name}</span>
                    <!-- Status pill -->
                    <span
                      class="text-[9px] font-black px-1.5 py-0.5 rounded leading-none"
                      style={`background: ${s.color}20; color: ${s.color};`}
                    >
                      {s.label}
                    </span>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

