---
import PageLayout from "../../layouts/PageLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ─────────────────────────────────────────────────────────────────────────────
// AI/ML AGENTS IN DEPARTMENT 06
// ─────────────────────────────────────────────────────────────────────────────
type AgentCard = {
  code: string;
  title: string;
  tier: string;
  focus: string;
  color: string;
};

const agents: AgentCard[] = [
  { code: "VP-AI",     title: "VP of AI",               tier: "Tier 1 — VP",        focus: "AI strategy, research direction, org leadership",          color: "#00D9FF" },
  { code: "DIR-DS",    title: "Director of Data Science",tier: "Tier 2 — Director",   focus: "Analytics, experimentation, statistical modeling",          color: "#00BFFF" },
  { code: "DIR-MLE",   title: "Director of ML Engineering",tier: "Tier 2 — Director", focus: "Model training pipelines, infra, GPU clusters",            color: "#00BFFF" },
  { code: "DIR-AIE",   title: "Director of AI Engineering",tier: "Tier 2 — Director", focus: "LLM integration, agent frameworks, production AI systems", color: "#00BFFF" },
  { code: "STAFF-DS",  title: "Staff Data Scientist",   tier: "Tier 4 — Staff+",     focus: "Advanced modeling, cross-team data strategy",               color: "#B026FF" },
  { code: "SR-DS",     title: "Senior Data Scientist",  tier: "Tier 5 — Senior IC",  focus: "Feature engineering, model validation, A/B testing",        color: "#B026FF" },
  { code: "DS",        title: "Data Scientist",         tier: "Tier 6 — Mid-Level",  focus: "Exploratory analysis, model prototyping",                   color: "#B026FF" },
  { code: "SR-MLE",    title: "Senior ML Engineer",     tier: "Tier 5 — Senior IC",  focus: "Model serving, MLOps, distributed training",               color: "#7C3AED" },
  { code: "MLE",       title: "ML Engineer",            tier: "Tier 6 — Mid-Level",  focus: "Training pipelines, model evaluation, deployment",          color: "#7C3AED" },
  { code: "SR-AIE",    title: "Senior AI Engineer",     tier: "Tier 5 — Senior IC",  focus: "LLM apps, RAG systems, agent orchestration",               color: "#00D9FF" },
  { code: "AI-RES",    title: "AI Researcher",          tier: "Tier 5 — Senior IC",  focus: "Novel architecture research, benchmarks, publications",     color: "#00D9FF" },
  { code: "AI-ETHICS", title: "AI Ethics Specialist",   tier: "Tier 5 — Senior IC",  focus: "Bias detection, fairness, responsible AI governance",       color: "#10B981" },
];

// ─────────────────────────────────────────────────────────────────────────────
// CORE CAPABILITIES
// ─────────────────────────────────────────────────────────────────────────────
type Capability = {
  icon: string;
  title: string;
  description: string;
  color: string;
};

const capabilities: Capability[] = [
  {
    icon: "🧠",
    title: "LLM Integration",
    description: "Production-grade large language model integration across OpenAI, Anthropic Claude, and open-source models. RAG pipelines, prompt engineering, context management, and multi-model routing.",
    color: "#00D9FF",
  },
  {
    icon: "🏋️",
    title: "Model Training",
    description: "End-to-end training pipelines from data ingestion through fine-tuning and evaluation. GPU cluster orchestration with Ray, distributed training across CUDA hardware, and experiment tracking with MLflow and Weights & Biases.",
    color: "#B026FF",
  },
  {
    icon: "🚀",
    title: "MLOps & Production",
    description: "Continuous model delivery with automated retraining triggers, canary deployments, model drift detection, and rollback. ONNX-based model optimization for low-latency inference at scale.",
    color: "#7C3AED",
  },
  {
    icon: "🔁",
    title: "Data Pipelines",
    description: "Scalable feature engineering and data processing with Apache Spark, Polars, and Pandas. Automated data quality validation, lineage tracking, and feature stores for consistent model inputs.",
    color: "#00D9FF",
  },
  {
    icon: "🤖",
    title: "AI Agent Systems",
    description: "Autonomous multi-agent architectures using LangChain, LlamaIndex, CrewAI, and AutoGen. Production agent systems with tool use, memory, planning, and human-in-the-loop checkpoints.",
    color: "#B026FF",
  },
  {
    icon: "⚖️",
    title: "AI Ethics & Governance",
    description: "Responsible AI practices built into every delivery: bias auditing, fairness metrics, explainability reporting, and compliance with emerging AI regulation frameworks.",
    color: "#10B981",
  },
];

// ─────────────────────────────────────────────────────────────────────────────
// TECH STACK
// ─────────────────────────────────────────────────────────────────────────────
type TechEntry = { name: string; category: string; color: string };

const techStack: TechEntry[] = [
  { name: "Python 3.12",              category: "Language",           color: "#3B82F6" },
  { name: "PyTorch 2.4",              category: "Deep Learning",      color: "#EF4444" },
  { name: "TensorFlow 2",             category: "Deep Learning",      color: "#F59E0B" },
  { name: "Hugging Face",             category: "LLM / Fine-tuning",  color: "#FFD21E" },
  { name: "LangChain",                category: "LLM Orchestration",  color: "#00D9FF" },
  { name: "LlamaIndex",               category: "RAG",                color: "#B026FF" },
  { name: "Pinecone",                 category: "Vector DB",          color: "#00D9FF" },
  { name: "Qdrant",                   category: "Vector DB",          color: "#7C3AED" },
  { name: "Weaviate",                 category: "Vector DB",          color: "#10B981" },
  { name: "Ray",                      category: "Distributed ML",     color: "#F59E0B" },
  { name: "MLflow",                   category: "Experiment Tracking", color: "#3B82F6" },
  { name: "Weights & Biases",         category: "Experiment Tracking", color: "#FFBE00" },
  { name: "OpenAI API",               category: "LLM Provider",       color: "#10B981" },
  { name: "Anthropic API",            category: "LLM Provider",       color: "#B026FF" },
  { name: "CUDA",                     category: "GPU Compute",        color: "#76B900" },
  { name: "ONNX",                     category: "Model Serving",      color: "#3B82F6" },
  { name: "Apache Spark",             category: "Data Processing",    color: "#EF4444" },
  { name: "scikit-learn",             category: "Classical ML",       color: "#F59E0B" },
  { name: "XGBoost",                  category: "Gradient Boosting",  color: "#3B82F6" },
  { name: "Modal",                    category: "Serverless GPU",     color: "#00D9FF" },
];

const agentCount = agents.length;
const capabilityCount = capabilities.length;
const techCount = techStack.length;
---

<PageLayout
  title="AI & Machine Learning Capabilities"
  description="From LLM integration to distributed model training — 12 specialist AI/ML agents delivering production-ready artificial intelligence across every domain."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 lg:py-16">

    <!-- ──────────────────────────────────────────────────────────────────────
         BREADCRUMB
         ────────────────────────────────────────────────────────────────────── -->
    <nav class="mb-8 text-sm text-[var(--text-secondary)]">
      <a href={`${base}/`} class="hover:text-quantum-blue transition-colors">Home</a>
      <span class="mx-2 opacity-40">/</span>
      <a href={`${base}/capabilities/`} class="hover:text-quantum-blue transition-colors">Capabilities</a>
      <span class="mx-2 opacity-40">/</span>
      <span class="text-[var(--text-primary)]">AI &amp; Machine Learning</span>
    </nav>

    <!-- ──────────────────────────────────────────────────────────────────────
         HERO
         ────────────────────────────────────────────────────────────────────── -->
    <div class="relative mb-14">
      <!-- Background accent -->
      <div class="absolute -top-8 -left-8 w-96 h-48 opacity-10 pointer-events-none" style="background: radial-gradient(ellipse, #B026FF, transparent 70%); filter: blur(60px);"></div>
      <div class="absolute -top-4 right-0 w-64 h-40 opacity-8 pointer-events-none" style="background: radial-gradient(ellipse, #00D9FF, transparent 70%); filter: blur(50px);"></div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface)] text-[10px] font-bold text-[#B026FF] tracking-widest uppercase mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#B026FF] animate-pulse"></span>
        Department 06 — Data Science &amp; AI/ML
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[var(--text-primary)] leading-tight tracking-tight mb-5">
        AI &amp; Machine<br />
        <span class="bg-gradient-to-r from-quantum-blue via-neon-purple to-neon-pink bg-clip-text text-transparent">Learning Capabilities</span>
      </h1>
      <p class="text-lg text-[var(--text-secondary)] max-w-2xl leading-relaxed mb-8">
        From prototype to production, our 12-agent AI/ML department delivers intelligent systems that learn, adapt, and scale — built with rigorous engineering discipline and responsible AI practices.
      </p>

      <!-- Stat chips -->
      <div class="flex flex-wrap gap-3">
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black text-quantum-blue">{agentCount}</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">AI/ML Agents</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black text-[#B026FF]">{capabilityCount}</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">Core Capabilities</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black" style="color: #10B981;">{techCount}+</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">Tools &amp; Frameworks</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
          <span class="text-2xl font-black text-[#F59E0B]">99.9%</span>
          <span class="text-xs text-[var(--text-secondary)] font-medium">Inference Uptime SLO</span>
        </div>
      </div>
    </div>

    <!-- ──────────────────────────────────────────────────────────────────────
         CORE CAPABILITIES
         ────────────────────────────────────────────────────────────────────── -->
    <section class="mb-14">
      <div class="mb-6">
        <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest">What We Deliver</p>
        <h2 class="text-2xl font-bold text-[var(--text-primary)] mt-1">Core Capabilities</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {capabilities.map((cap) => (
          <div
            class="nexus-card p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[rgba(0,217,255,0.25)] transition-all"
            style={`border-left: 3px solid ${cap.color};`}
          >
            <div class="text-3xl mb-3" aria-hidden="true">{cap.icon}</div>
            <h3 class="text-base font-bold text-[var(--text-primary)] mb-2">{cap.title}</h3>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{cap.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────────────
         AGENT ROSTER
         ────────────────────────────────────────────────────────────────────── -->
    <section class="mb-14">
      <div class="mb-6">
        <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest">Department 06</p>
        <h2 class="text-2xl font-bold text-[var(--text-primary)] mt-1">The AI/ML Team</h2>
        <p class="text-sm text-[var(--text-secondary)] mt-1">12 specialist agents across research, engineering, and ethics</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {agents.map((agent) => (
          <a
            href={`${base}/agents/`}
            class="group flex items-start gap-4 p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[rgba(0,217,255,0.3)] transition-all"
          >
            <!-- Code badge -->
            <div
              class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center text-[10px] font-black leading-tight text-center"
              style={`background: ${agent.color}18; color: ${agent.color}; border: 1.5px solid ${agent.color}30;`}
            >
              {agent.code}
            </div>
            <!-- Info -->
            <div class="min-w-0">
              <div class="text-sm font-bold text-[var(--text-primary)] group-hover:text-quantum-blue transition-colors truncate">
                {agent.title}
              </div>
              <div class="text-[11px] text-[var(--text-muted)] mb-1">{agent.tier}</div>
              <div class="text-[11px] text-[var(--text-secondary)] leading-snug">{agent.focus}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────────────
         TECH STACK
         ────────────────────────────────────────────────────────────────────── -->
    <section class="mb-14">
      <div class="mb-6">
        <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest">Production Stack</p>
        <h2 class="text-2xl font-bold text-[var(--text-primary)] mt-1">AI/ML Technology Stack</h2>
        <p class="text-sm text-[var(--text-secondary)] mt-1">The tools and frameworks powering every model from experiment to production</p>
      </div>
      <div class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] overflow-hidden"
           style="border-left: 4px solid #B026FF;">
        <div class="px-6 py-4 border-b border-[var(--border-color)]" style="background: rgba(176,38,255,0.04);">
          <p class="text-sm font-bold text-[var(--text-primary)]">Department 06 — Data Science &amp; AI/ML</p>
          <p class="text-xs text-[var(--text-muted)]">12 agents &middot; {techCount}+ tools &middot; {techCount} adopted</p>
        </div>
        <div class="p-5 flex flex-wrap gap-2">
          {techStack.map((tech) => (
            <div
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border transition-all"
              style="background: rgba(176,38,255,0.06); border-color: rgba(176,38,255,0.2);"
              title={tech.category}
            >
              <span class="text-xs font-mono font-semibold text-[var(--text-primary)]">{tech.name}</span>
              <span
                class="text-[9px] font-black px-1.5 py-0.5 rounded leading-none"
                style={`background: ${tech.color}25; color: ${tech.color};`}
              >
                {tech.category}
              </span>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-4 text-center">
        <a
          href={`${base}/capabilities/tech-stack/`}
          class="text-sm text-quantum-blue hover:text-orbital-cyan transition-colors font-medium"
        >
          View full tech arsenal across all 20 departments &rarr;
        </a>
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────────────
         HOW WE WORK — PROCESS OVERVIEW
         ────────────────────────────────────────────────────────────────────── -->
    <section class="mb-14">
      <div class="mb-6">
        <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest">Our Process</p>
        <h2 class="text-2xl font-bold text-[var(--text-primary)] mt-1">From Experiment to Production</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { step: "01", label: "Discovery", desc: "Problem framing, data audit, feasibility assessment, success metric definition." },
          { step: "02", label: "Experimentation", desc: "Rapid prototyping, baseline benchmarks, model selection, feature engineering." },
          { step: "03", label: "Engineering", desc: "Production pipelines, MLOps setup, infrastructure provisioning, serving layer build." },
          { step: "04", label: "Operations", desc: "Continuous monitoring, drift detection, retraining automation, ethics review." },
        ].map((phase) => (
          <div class="p-5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
            <div class="text-3xl font-black text-[rgba(0,217,255,0.2)] mb-3 leading-none">{phase.step}</div>
            <h3 class="text-sm font-bold text-[var(--text-primary)] mb-2">{phase.label}</h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">{phase.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ──────────────────────────────────────────────────────────────────────
         FOOTER CTA
         ────────────────────────────────────────────────────────────────────── -->
    <div class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] p-8 md:p-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[rgba(176,38,255,0.3)] bg-[rgba(176,38,255,0.08)] text-[10px] font-bold text-[#B026FF] tracking-widest uppercase mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#B026FF]"></span>
        AI/ML Department — Ready to Deploy
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] mb-3">
        Ready to build something intelligent?
      </h2>
      <p class="text-[var(--text-secondary)] mb-8 max-w-xl mx-auto text-sm leading-relaxed">
        Our 12-agent AI/ML department deploys immediately. From a single LLM integration to a full autonomous agent system — we scope, build, and ship production-grade AI.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`${base}/contact/`}
          class="inline-flex items-center gap-2 px-7 py-3 rounded-lg bg-quantum-blue text-nexus-black font-bold text-sm hover:bg-orbital-cyan transition-colors"
        >
          Start an AI Project
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href={`${base}/agents/`}
          class="inline-flex items-center gap-2 px-7 py-3 rounded-lg border border-[var(--border-color)] text-[var(--text-primary)] font-bold text-sm hover:border-quantum-blue/50 transition-colors"
        >
          Meet the 195 Agents
        </a>
      </div>
    </div>

  </div>
</PageLayout>
