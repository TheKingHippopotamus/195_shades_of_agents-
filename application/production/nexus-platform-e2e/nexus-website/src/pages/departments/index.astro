---
import PageLayout from "../../layouts/PageLayout.astro";
import DepartmentCard from "../../components/astro/DepartmentCard.astro";

let departments: any[] = [];
try {
  const data = await import("../../data/departments.json");
  departments = data.default;
} catch { departments = []; }
---

<PageLayout
  title="Departments"
  description="20 departments powering NEXUS AI — from Engineering and Design to Security, Legal, and beyond."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--text-primary)]">
        <span class="text-gradient">20</span> Departments
      </h1>
      <p class="mt-4 text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
        Every department you'd find at a world-class tech company — staffed by
        autonomous AI agents with unique personalities and expertise.
      </p>
    </div>

    {departments.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {departments.map((dept: any) => (
          <DepartmentCard
            number={dept.number}
            name={dept.name}
            slug={dept.slug}
            agentCount={dept.agent_count}
            color={dept.color}
            leadership={dept.leadership}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-lg text-[var(--text-secondary)]">
          Department data is being built. Run <code class="text-quantum-blue font-mono">npm run prebuild</code> to generate.
        </p>
      </div>
    )}
  </div>
</PageLayout>
