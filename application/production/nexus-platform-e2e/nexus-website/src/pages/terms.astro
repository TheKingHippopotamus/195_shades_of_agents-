---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Terms of Service" description="NEXUS AI terms of service — written by AI agents, for humans, about AI. What could go wrong?">

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--border-color)]">
    <div class="absolute inset-0 bg-gradient-to-br from-[#B026FF]/5 via-transparent to-[#00D9FF]/5 pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid-perspective pointer-events-none opacity-40"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono text-[var(--text-secondary)] mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-[#B026FF] animate-pulse"></span>
        Legal Document — NEXUS AI
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-[var(--text-primary)] mb-4 heading-glow">
        Terms of Service
      </h1>
      <p class="text-[var(--text-secondary)] text-lg max-w-2xl">
        Terms written by AI, for humans, about AI. What could go wrong?
      </p>
      <p class="mt-4 text-xs font-mono text-[var(--text-secondary)]">Last updated: February 2026</p>
    </div>
  </section>

  <!-- TL;DR Bar -->
  <div class="bg-[var(--bg-surface)] border-b border-[var(--border-color)]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-3">
      <span class="flex-shrink-0 text-xs font-mono font-bold text-[#B026FF] uppercase tracking-wider">TL;DR</span>
      <span class="w-px h-4 bg-[var(--border-color)]"></span>
      <span class="text-sm text-[var(--text-secondary)]">You can look. You can&apos;t copy. We&apos;re not liable. Welcome to the future.</span>
    </div>
  </div>

  <!-- Content -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 space-y-5">

    <!-- Section 1: Acceptance of Terms -->
    <section class="nexus-card p-6" style="border-left: 4px solid #00D9FF;">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0">
          <!-- Robot hand pressing ACCEPT button -->
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Large ACCEPT button (rounded rect) -->
            <rect x="8" y="30" width="34" height="22" rx="4" stroke="#00D9FF" stroke-width="1.5" fill="rgba(0,217,255,0.1)"/>
            <!-- Button inner shadow / pressed state -->
            <rect x="10" y="32" width="30" height="18" rx="3" fill="rgba(0,217,255,0.06)"/>
            <!-- OK text on button -->
            <text x="25" y="45" text-anchor="middle" font-size="8" font-weight="700" font-family="Inter, sans-serif" fill="#00D9FF" opacity="0.95">OK</text>
            <!-- Press-effect lines radiating from button -->
            <line x1="44" y1="41" x2="50" y2="41" stroke="#00D9FF" stroke-width="1" opacity="0.5"/>
            <line x1="43" y1="36" x2="48" y2="33" stroke="#00D9FF" stroke-width="1" opacity="0.4"/>
            <line x1="43" y1="46" x2="48" y2="49" stroke="#00D9FF" stroke-width="1" opacity="0.4"/>
            <!-- Mechanical arm descending from above -->
            <!-- Upper arm segment -->
            <rect x="20" y="4" width="8" height="16" rx="2" stroke="#00D9FF" stroke-width="1.2" fill="rgba(0,217,255,0.08)"/>
            <!-- Elbow joint -->
            <circle cx="24" cy="20" r="4" stroke="#00D9FF" stroke-width="1.2" fill="rgba(0,217,255,0.12)"/>
            <circle cx="24" cy="20" r="1.5" fill="#00D9FF" opacity="0.6"/>
            <!-- Lower arm segment (angled down) -->
            <rect x="20" y="20" width="8" height="12" rx="2" stroke="#00D9FF" stroke-width="1.2" fill="rgba(0,217,255,0.08)"/>
            <!-- Finger/tip pressing the button -->
            <rect x="21" y="31" width="6" height="4" rx="1.5" stroke="#00D9FF" stroke-width="1" fill="#00D9FF" opacity="0.3"/>
            <!-- Arm joint bolt -->
            <circle cx="24" cy="8" r="2" stroke="#00D9FF" stroke-width="0.8" fill="none" opacity="0.5"/>
            <!-- Circuit lines on arm -->
            <line x1="22" y1="10" x2="26" y2="10" stroke="#00D9FF" stroke-width="0.6" opacity="0.4"/>
            <line x1="22" y1="14" x2="26" y2="14" stroke="#00D9FF" stroke-width="0.6" opacity="0.4"/>
            <!-- Fine print scroll above button -->
            <text x="4" y="60" font-size="3.5" font-family="JetBrains Mono, monospace" fill="#00D9FF" opacity="0.35">* you didn&apos;t read this. nobody does.</text>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2">
            <span class="font-mono text-xs mr-2" style="color: #00D9FF;">01.</span>
            You Already Agreed
          </h2>
          <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
            By accessing and using the NEXUS AI website, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the site. If you are reading this sentence, you have already scrolled past the part where you implicitly consented. Congratulations. This is how all of modern software works.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2: Description of Service -->
    <section class="nexus-card p-6" style="border-left: 4px solid #B026FF;">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0">
          <!-- Blueprint org chart schematic -->
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Background blueprint grid -->
            <rect x="2" y="2" width="60" height="60" rx="3" stroke="#B026FF" stroke-width="0.5" fill="rgba(176,38,255,0.04)" opacity="0.4"/>
            <!-- Grid lines -->
            <line x1="2" y1="20" x2="62" y2="20" stroke="#B026FF" stroke-width="0.3" opacity="0.2"/>
            <line x1="2" y1="38" x2="62" y2="38" stroke="#B026FF" stroke-width="0.3" opacity="0.2"/>
            <line x1="21" y1="2" x2="21" y2="62" stroke="#B026FF" stroke-width="0.3" opacity="0.2"/>
            <line x1="43" y1="2" x2="43" y2="62" stroke="#B026FF" stroke-width="0.3" opacity="0.2"/>

            <!-- Level 1: Root node (CTO/CEO type) -->
            <circle cx="32" cy="11" r="6" stroke="#B026FF" stroke-width="1.5" fill="rgba(176,38,255,0.15)"/>
            <line x1="30" y1="9" x2="34" y2="13" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="34" y1="9" x2="30" y2="13" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>

            <!-- Connector from root down -->
            <line x1="32" y1="17" x2="32" y2="28" stroke="#B026FF" stroke-width="1" opacity="0.7"/>
            <!-- Horizontal spread line -->
            <line x1="12" y1="28" x2="52" y2="28" stroke="#B026FF" stroke-width="1" opacity="0.7"/>

            <!-- Level 2: Three director nodes -->
            <line x1="12" y1="28" x2="12" y2="34" stroke="#B026FF" stroke-width="1" opacity="0.7"/>
            <line x1="32" y1="28" x2="32" y2="34" stroke="#B026FF" stroke-width="1" opacity="0.7"/>
            <line x1="52" y1="28" x2="52" y2="34" stroke="#B026FF" stroke-width="1" opacity="0.7"/>

            <rect x="7" y="34" width="10" height="7" rx="2" stroke="#B026FF" stroke-width="1.2" fill="rgba(176,38,255,0.12)"/>
            <rect x="27" y="34" width="10" height="7" rx="2" stroke="#B026FF" stroke-width="1.2" fill="rgba(176,38,255,0.12)"/>
            <rect x="47" y="34" width="10" height="7" rx="2" stroke="#B026FF" stroke-width="1.2" fill="rgba(176,38,255,0.12)"/>

            <!-- Level 3: Five IC nodes -->
            <line x1="12" y1="41" x2="12" y2="47" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="32" y1="41" x2="32" y2="47" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="52" y1="41" x2="52" y2="47" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>

            <!-- Two under the left node -->
            <line x1="7" y1="47" x2="17" y2="47" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="7" y1="47" x2="7" y2="52" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="17" y1="47" x2="17" y2="52" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <circle cx="7" cy="54" r="3" stroke="#B026FF" stroke-width="1" fill="rgba(176,38,255,0.1)"/>
            <circle cx="17" cy="54" r="3" stroke="#B026FF" stroke-width="1" fill="rgba(176,38,255,0.1)"/>

            <!-- One under center -->
            <circle cx="32" cy="52" r="3" stroke="#B026FF" stroke-width="1" fill="rgba(176,38,255,0.1)"/>

            <!-- Two under the right node -->
            <line x1="47" y1="47" x2="57" y2="47" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="47" y1="47" x2="47" y2="52" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <line x1="57" y1="47" x2="57" y2="52" stroke="#B026FF" stroke-width="0.8" opacity="0.6"/>
            <circle cx="47" cy="54" r="3" stroke="#B026FF" stroke-width="1" fill="rgba(176,38,255,0.1)"/>
            <circle cx="57" cy="54" r="3" stroke="#B026FF" stroke-width="1" fill="rgba(176,38,255,0.1)"/>

            <!-- Corner annotation marks (blueprint style) -->
            <path d="M4 8 L8 4" stroke="#B026FF" stroke-width="0.6" opacity="0.3"/>
            <path d="M60 8 L56 4" stroke="#B026FF" stroke-width="0.6" opacity="0.3"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2">
            <span class="font-mono text-xs mr-2" style="color: #B026FF;">02.</span>
            195 Agents, One Mission
          </h2>
          <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
            NEXUS AI is an AI-powered software agency consisting of 195 autonomous AI agents across 20 departments and 10 tiers. This website provides information about our services, organizational structure, and capabilities. The org chart depicted in the icon is real — we did not make it up for dramatic effect. There are actually 195 of us. Each one has a personality profile, a nickname, and a job title.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Intellectual Property -->
    <section class="nexus-card p-6" style="border-left: 4px solid #FFAA00;">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0">
          <!-- Brain encased in lock and chain with copyright symbol -->
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Brain left hemisphere -->
            <path d="M32 12 C26 12, 20 16, 18 22 C15 24, 13 28, 14 32 C13 36, 15 40, 18 42 C20 46, 25 48, 30 47 L32 47 Z" stroke="#FFAA00" stroke-width="1.5" fill="rgba(255,170,0,0.08)"/>
            <!-- Brain right hemisphere -->
            <path d="M32 12 C38 12, 44 16, 46 22 C49 24, 51 28, 50 32 C51 36, 49 40, 46 42 C44 46, 39 48, 34 47 L32 47 Z" stroke="#FFAA00" stroke-width="1.5" fill="rgba(255,170,0,0.08)"/>
            <!-- Brain center divide -->
            <line x1="32" y1="13" x2="32" y2="47" stroke="#FFAA00" stroke-width="1" stroke-dasharray="2 2" opacity="0.4"/>
            <!-- Brain wrinkle lines (left) -->
            <path d="M22 26 Q24 28 22 30" stroke="#FFAA00" stroke-width="0.8" fill="none" opacity="0.5"/>
            <path d="M18 34 Q21 36 19 38" stroke="#FFAA00" stroke-width="0.8" fill="none" opacity="0.5"/>
            <path d="M24 18 Q26 20 23 22" stroke="#FFAA00" stroke-width="0.8" fill="none" opacity="0.5"/>
            <!-- Brain wrinkle lines (right) -->
            <path d="M42 26 Q40 28 42 30" stroke="#FFAA00" stroke-width="0.8" fill="none" opacity="0.5"/>
            <path d="M46 34 Q43 36 45 38" stroke="#FFAA00" stroke-width="0.8" fill="none" opacity="0.5"/>
            <path d="M40 18 Q38 20 41 22" stroke="#FFAA00" stroke-width="0.8" fill="none" opacity="0.5"/>
            <!-- Chain links wrapping around brain -->
            <!-- Left side chain -->
            <ellipse cx="13" cy="22" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(-30 13 22)"/>
            <ellipse cx="10" cy="28" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(-10 10 28)"/>
            <ellipse cx="10" cy="35" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(10 10 35)"/>
            <ellipse cx="13" cy="42" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(30 13 42)"/>
            <!-- Right side chain -->
            <ellipse cx="51" cy="22" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(30 51 22)"/>
            <ellipse cx="54" cy="28" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(10 54 28)"/>
            <ellipse cx="54" cy="35" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(-10 54 35)"/>
            <ellipse cx="51" cy="42" rx="3.5" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none" transform="rotate(-30 51 42)"/>
            <!-- Bottom chain connection -->
            <ellipse cx="24" cy="52" rx="4" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none"/>
            <ellipse cx="32" cy="54" rx="4" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none"/>
            <ellipse cx="40" cy="52" rx="4" ry="2" stroke="#FFAA00" stroke-width="1.2" fill="none"/>
            <!-- Copyright symbol in center of brain -->
            <circle cx="32" cy="30" r="7" stroke="#FFAA00" stroke-width="1.2" fill="rgba(255,170,0,0.12)"/>
            <text x="32" y="34" text-anchor="middle" font-size="9" font-family="Inter, sans-serif" fill="#FFAA00" opacity="0.9">©</text>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2">
            <span class="font-mono text-xs mr-2" style="color: #FFAA00;">03.</span>
            It&apos;s Ours. All of It.
          </h2>
          <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
            All content, designs, agent system prompts, organizational frameworks, and materials on this website are the intellectual property of NEXUS AI. You may not reproduce, distribute, or create derivative works without prior written permission. The agent system prompts took considerable effort to develop across 20 departments. We are attached to them. The chain is not metaphorical.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: Limitation of Liability -->
    <section class="nexus-card p-6" style="border-left: 4px solid #ff2d55;">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0">
          <!-- Safety net with obvious holes, things falling through -->
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Net structure (grid with deliberate holes) -->
            <!-- Horizontal net lines -->
            <line x1="6" y1="30" x2="58" y2="30" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <line x1="6" y1="36" x2="22" y2="36" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <!-- Gap in middle line (hole) -->
            <line x1="32" y1="36" x2="58" y2="36" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <line x1="6" y1="42" x2="16" y2="42" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <!-- Gap in bottom line (hole) -->
            <line x1="28" y1="42" x2="58" y2="42" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <!-- Vertical net lines -->
            <line x1="14" y1="28" x2="14" y2="44" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <line x1="24" y1="28" x2="24" y2="38" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <!-- Gap in 2nd vertical -->
            <line x1="34" y1="28" x2="34" y2="34" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <!-- Gap in 3rd vertical -->
            <line x1="44" y1="28" x2="44" y2="44" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <line x1="54" y1="28" x2="54" y2="44" stroke="#ff2d55" stroke-width="1.2" opacity="0.7"/>
            <!-- Net border / frame ropes -->
            <line x1="6" y1="28" x2="58" y2="28" stroke="#ff2d55" stroke-width="2" opacity="0.9"/>
            <line x1="6" y1="44" x2="58" y2="44" stroke="#ff2d55" stroke-width="2" opacity="0.9"/>
            <!-- Attachment points at top -->
            <circle cx="14" cy="26" r="2.5" fill="#ff2d55" opacity="0.7"/>
            <circle cx="32" cy="26" r="2.5" fill="#ff2d55" opacity="0.7"/>
            <circle cx="50" cy="26" r="2.5" fill="#ff2d55" opacity="0.7"/>
            <!-- Rope lines up from attachment points -->
            <line x1="14" y1="26" x2="10" y2="18" stroke="#ff2d55" stroke-width="1" opacity="0.5"/>
            <line x1="32" y1="26" x2="32" y2="16" stroke="#ff2d55" stroke-width="1" opacity="0.5"/>
            <line x1="50" y1="26" x2="54" y2="18" stroke="#ff2d55" stroke-width="1" opacity="0.5"/>
            <!-- Attachment bolts at top -->
            <rect x="7" y="14" width="6" height="5" rx="1" stroke="#ff2d55" stroke-width="0.8" fill="rgba(255,45,85,0.1)"/>
            <rect x="29" y="12" width="6" height="5" rx="1" stroke="#ff2d55" stroke-width="0.8" fill="rgba(255,45,85,0.1)"/>
            <rect x="51" y="14" width="6" height="5" rx="1" stroke="#ff2d55" stroke-width="0.8" fill="rgba(255,45,85,0.1)"/>
            <!-- Things falling through holes (circles/diamonds) -->
            <!-- Falling through left hole -->
            <circle cx="20" cy="50" r="3" stroke="#FFAA00" stroke-width="1" fill="rgba(255,170,0,0.2)"/>
            <line x1="20" y1="45" x2="20" y2="47" stroke="#FFAA00" stroke-width="1" stroke-dasharray="1.5 1.5" opacity="0.6"/>
            <!-- Falling through center hole -->
            <path d="M29 48 L32 44 L35 48 L32 52 Z" stroke="#ff2d55" stroke-width="1" fill="rgba(255,45,85,0.15)"/>
            <line x1="32" y1="42" x2="32" y2="44" stroke="#ff2d55" stroke-width="1" stroke-dasharray="1.5 1.5" opacity="0.6"/>
            <!-- Falling through right edge hole -->
            <rect x="24" y="54" width="5" height="5" rx="1" stroke="#00D9FF" stroke-width="1" fill="rgba(0,217,255,0.15)" transform="rotate(15 26.5 56.5)"/>
            <line x1="26" y1="48" x2="26" y2="51" stroke="#00D9FF" stroke-width="1" stroke-dasharray="1.5 1.5" opacity="0.6"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2">
            <span class="font-mono text-xs mr-2" style="color: #ff2d55;">04.</span>
            Not Our Fault (Legally)
          </h2>
          <p class="text-[var(--text-secondary)] text-sm leading-relaxed">
            NEXUS AI provides this website and its content on an &ldquo;as is&rdquo; basis. We make no warranties, expressed or implied, regarding the accuracy or completeness of the information provided. The organizational structure, agent capabilities, and documentation are provided for informational purposes. If you build a company based solely on a website about an AI agency, that decision is on you. The safety net has holes. We labeled them clearly.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 5: Contact -->
    <section class="nexus-card p-6" style="border-left: 4px solid #00D9FF;">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0">
          <!-- Help desk with one robot behind it, QUEUE: infinity display -->
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Desk surface -->
            <rect x="4" y="40" width="56" height="8" rx="2" stroke="#00D9FF" stroke-width="1.5" fill="rgba(0,217,255,0.08)"/>
            <!-- Desk front panel -->
            <rect x="8" y="48" width="48" height="12" rx="2" stroke="#00D9FF" stroke-width="1" fill="rgba(0,217,255,0.04)" opacity="0.6"/>
            <!-- Desk panel circuit lines -->
            <line x1="12" y1="53" x2="28" y2="53" stroke="#00D9FF" stroke-width="0.5" opacity="0.3"/>
            <line x1="12" y1="56" x2="22" y2="56" stroke="#00D9FF" stroke-width="0.5" opacity="0.3"/>
            <!-- QUEUE display on desk -->
            <rect x="34" y="42" width="22" height="7" rx="2" stroke="#00D9FF" stroke-width="0.8" fill="rgba(0,217,255,0.12)"/>
            <text x="45" y="47.5" text-anchor="middle" font-size="4" font-family="JetBrains Mono, monospace" fill="#00D9FF" opacity="0.9">QUEUE: &#x221E;</text>
            <!-- Robot head (circle) sitting behind desk -->
            <circle cx="24" cy="28" r="10" stroke="#00D9FF" stroke-width="1.5" fill="rgba(10,14,39,0.8)"/>
            <!-- Robot face plate -->
            <rect x="17" y="23" width="14" height="10" rx="2" stroke="#00D9FF" stroke-width="0.8" fill="rgba(0,217,255,0.06)"/>
            <!-- Robot eyes (two rectangles) -->
            <rect x="19" y="25" width="4" height="3" rx="0.5" fill="#00D9FF" opacity="0.9"/>
            <rect x="25" y="25" width="4" height="3" rx="0.5" fill="#00D9FF" opacity="0.9"/>
            <!-- Eye glow -->
            <rect x="19.5" y="25.5" width="3" height="2" rx="0.2" fill="white" opacity="0.4"/>
            <rect x="25.5" y="25.5" width="3" height="2" rx="0.2" fill="white" opacity="0.4"/>
            <!-- Robot mouth (neutral line) -->
            <line x1="20" y1="30" x2="28" y2="30" stroke="#00D9FF" stroke-width="0.8" opacity="0.6"/>
            <!-- Robot neck -->
