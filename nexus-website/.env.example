# Sanity CMS (build-time only — fetched during CI, not shipped to client)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_read_only_api_token

# Analytics (public-safe, included in client HTML)
# PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Forms (public-safe, included in client HTML)
# PUBLIC_FORMSPREE_ID=your_form_id

# Resend email API (server-side only — NEVER expose to client)
# Set this in GitHub repo Secrets as RESEND_API_KEY
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
