---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "NEXUS AI — 195 autonomous AI agents across 20 departments, building software like a real company.",
  ogImage = "/og/default.png",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === "NEXUS AI" ? title : `${title} | NEXUS AI`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts (preconnect + display=swap for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/195_shades_of_agents-/brand/favicon.svg" />

    <!-- Security meta tags (GitHub Pages limited header config) -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co https://plausible.io" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- JSON-LD Organization (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "NEXUS AI",
      "description": "AI-powered software agency with 195 autonomous agents across 20 departments.",
      "url": Astro.site?.toString(),
      "numberOfEmployees": { "@type": "QuantitativeValue", "value": 195 },
    })} />

    <!-- Theme initialization (prevent FOUC) -->
    <script is:inline>
      const theme = localStorage.getItem("nexus-theme") ||
        (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body
    class="min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)] font-sans antialiased cosmic-bg"
  >
    <!-- Starfield background -->
    <div class="starfield" aria-hidden="true"></div>

    <!-- Nebula effects -->
    <div class="nebula nebula-cyan" style="width: 600px; height: 600px; top: 10%; left: -5%;" aria-hidden="true"></div>
    <div class="nebula nebula-purple" style="width: 500px; height: 500px; top: 60%; right: -10%; animation-delay: -10s;" aria-hidden="true"></div>
    <div class="nebula nebula-magenta" style="width: 400px; height: 400px; top: 30%; left: 40%; animation-delay: -20s;" aria-hidden="true"></div>

    <!-- Scanline overlay -->
    <div class="fixed inset-0 scanlines z-[1] pointer-events-none" aria-hidden="true"></div>

    <!-- Main content above the effects -->
    <div class="relative z-[2]">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>
