---
import PageLayout from "../layouts/PageLayout.astro";
import NetworkGraph from "../components/react/NetworkGraph.tsx";
---

<PageLayout
  title="Agent Network"
  description="Interactive visualization of NEXUS AI's 195 agents and their connections across 20 departments."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--text-primary)]">
        Agent <span class="text-gradient">Network</span>
      </h1>
      <p class="mt-4 text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
        A force-directed graph of 195 agents across 20 departments. Nodes
        represent agents, edges represent reporting chains. Colors indicate
        department membership. Drag, zoom, and click to explore.
      </p>
    </div>

    <NetworkGraph client:visible />
  </div>
</PageLayout>
