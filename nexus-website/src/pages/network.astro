---
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeading from "../components/astro/SectionHeading.astro";
import NetworkGraph from "../components/react/NetworkGraph.tsx";

let agents: any[] = [];
let departments: any[] = [];
try {
  const agentData = await import("../data/agents.json");
  agents = agentData.default;
  const deptData = await import("../data/departments.json");
  departments = deptData.default;
} catch {}

const totalAgents = agents.length || 195;
const totalDepts = departments.length || 20;

// Compute network statistics from live data
const reportsToCount = agents.filter((a: any) => a.reports_to && a.reports_to !== "Board of Directors / Client (as ultimate stakeholder)").length;
const tierCounts: Record<number, number> = {};
agents.forEach((a: any) => {
  const t = a.tier?.number ?? -1;
  tierCounts[t] = (tierCounts[t] || 0) + 1;
});

// Find most-connected agents (most direct reports)
const reportCounts: Record<string, number> = {};
agents.forEach((a: any) => {
  if (a.reports_to && typeof a.reports_to === "string") {
    const mgr = a.reports_to;
    reportCounts[mgr] = (reportCounts[mgr] || 0) + 1;
  }
});
const topHubs = Object.entries(reportCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([code, count]) => {
    const agent = agents.find((a: any) => a.code === code);
    return { code, count, role: agent?.role || code, dept: agent?.department || "" };
  });

// Department sizes for insights
const deptSizes = departments.map((d: any) => ({
  name: d.name,
  count: d.agent_count,
  color: d.color,
  number: d.number,
})).sort((a: any, b: any) => b.count - a.count);

// Tier labels
const tierLabels: Record<number, string> = {
  0: "C-Suite", 1: "VPs", 2: "Directors", 3: "Managers", 4: "Staff+ ICs",
  5: "Senior ICs", 6: "Mid-Level", 7: "Junior", 8: "Governance", 9: "Special",
};
---

<PageLayout
  title="Agent Network"
  description="Interactive force-directed visualization of NEXUS AI's 195 agents and their reporting chains across 20 departments."
>
  <!-- Hero / Introduction -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] mb-6">
          The <span class="text-gradient">Network</span>
        </h1>
        <p class="text-xl text-[var(--text-secondary)] leading-relaxed mb-6">
          Explore how {totalAgents} autonomous AI agents connect across {totalDepts}
          departments. Every node is an agent. Every edge is a reporting chain.
          Together they form the organizational nervous system of NEXUS AI.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium bg-[var(--accent-muted)] text-[var(--accent-text)]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
            Click agents for details
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium bg-[var(--accent-muted)] text-[var(--accent-text)]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
            Scroll to zoom
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium bg-[var(--accent-muted)] text-[var(--accent-text)]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0 0v2.5m0-2.5h2.5M7 14H4.5m4-5.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" /></svg>
            Drag to reposition
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium bg-[var(--accent-muted)] text-[var(--accent-text)]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
            Hover to highlight department
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content: Graph + Sidebar -->
  <section class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8 pb-8">
    <div class="grid lg:grid-cols-[1fr_320px] gap-6">

      <!-- Graph Container -->
      <div>
        <NetworkGraph client:visible />
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">

        <!-- Interactive Legend: Department Colors -->
        <div class="nexus-card p-5">
          <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-3 uppercase tracking-wide">Departments</h3>
          <div class="space-y-1.5 max-h-[340px] overflow-y-auto pr-1">
            {departments.map((dept: any) => (
              <a
                href={`/195_shades_of_agents-/departments/${dept.slug}`}
                class="flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-[var(--bg-elevated)] transition-colors group"
              >
                <span
                  class="h-3 w-3 rounded-full flex-shrink-0 ring-2 ring-transparent group-hover:ring-offset-1 group-hover:ring-offset-[var(--bg-surface)] transition-all"
                  style={`background-color: ${dept.color}`}
                />
                <span class="text-xs text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors flex-1 truncate">
                  {dept.name}
                </span>
                <span class="text-[10px] font-mono text-[var(--text-muted)]">{dept.agent_count}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Node Size Legend: Tier Hierarchy -->
        <div class="nexus-card p-5">
          <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-3 uppercase tracking-wide">Node Size by Tier</h3>
          <p class="text-xs text-[var(--text-muted)] mb-3">Larger nodes indicate higher authority tiers.</p>
          <div class="space-y-2">
            {[
              { tier: 0, label: "C-Suite", radius: 18 },
              { tier: 1, label: "VPs", radius: 14 },
              { tier: 2, label: "Directors", radius: 12 },
              { tier: 3, label: "Managers", radius: 10 },
              { tier: 5, label: "Senior ICs", radius: 8 },
              { tier: 6, label: "Mid-Level", radius: 7 },
              { tier: 7, label: "Junior", radius: 6 },
              { tier: 8, label: "Governance", radius: 9 },
              { tier: 9, label: "Special", radius: 10 },
            ].map((item) => (
              <div class="flex items-center gap-3">
                <div class="flex items-center justify-center w-10">
                  <span
                    class="rounded-full bg-[var(--accent)] opacity-70"
                    style={`width: ${item.radius * 2}px; height: ${item.radius * 2}px;`}
                  />
                </div>
                <span class="text-xs text-[var(--text-secondary)]">
                  Tier {item.tier} &mdash; {item.label}
                </span>
                <span class="text-[10px] font-mono text-[var(--text-muted)] ml-auto">
                  {tierCounts[item.tier] || 0}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Edge Legend -->
        <div class="nexus-card p-5">
          <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-3 uppercase tracking-wide">Edge Meaning</h3>
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-1">
              <svg width="40" height="12">
                <line x1="0" y1="6" x2="40" y2="6" stroke="var(--border-color)" stroke-width="1.5" />
              </svg>
            </div>
            <p class="text-xs text-[var(--text-secondary)]">
              Each line represents a <code class="text-[10px] bg-[var(--bg-elevated)] px-1 py-0.5 rounded font-mono">reports_to</code> relationship.
              Every agent reports to exactly one manager, forming a tree rooted at the CEO.
            </p>
          </div>
        </div>

        <!-- Use Cases -->
        <div class="nexus-card p-5">
          <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-3 uppercase tracking-wide">What to Discover</h3>
          <ul class="space-y-2.5">
            {[
              { icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7", label: "Reporting Chains", desc: "Trace who reports to whom from junior ICs to the CEO." },
              { icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z", label: "Expertise Clusters", desc: "See how specialist agents cluster by department color." },
              { icon: "M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm0 8a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zm12 0a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z", label: "Department Structure", desc: "Identify the internal structure of each department." },
              { icon: "M13 10V3L4 14h7v7l9-11h-7z", label: "Key Connection Hubs", desc: "Find the most connected agents that bridge departments." },
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 flex-shrink-0 mt-0.5 text-[var(--accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
                <div>
                  <span class="text-xs font-semibold text-[var(--text-primary)]">{item.label}</span>
                  <p class="text-[11px] text-[var(--text-muted)] leading-relaxed">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- Network Statistics -->
  <section class="bg-[var(--bg-surface)] border-y border-[var(--border-color)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <SectionHeading
        title="Network Statistics"
        subtitle="Computed from the live organizational graph of NEXUS AI."
      />

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {[
          { value: totalAgents.toString(), label: "Total Agents", sub: "Nodes in the graph" },
          { value: reportsToCount.toString(), label: "Reporting Edges", sub: "Manager-report links" },
          { value: totalDepts.toString(), label: "Departments", sub: "Color-coded clusters" },
          { value: "10", label: "Tier Levels", sub: "Tier 0 through Tier 9" },
          { value: (reportsToCount / totalAgents).toFixed(1), label: "Avg. Degree", sub: "Connections per node" },
          { value: "10", label: "Tree Depth", sub: "CEO to leaf agents" },
        ].map((stat) => (
          <div class="nexus-card p-5 text-center">
            <div class="text-2xl md:text-3xl font-bold text-gradient">{stat.value}</div>
            <div class="text-sm font-semibold text-[var(--text-primary)] mt-1">{stat.label}</div>
            <div class="text-[11px] text-[var(--text-muted)] mt-0.5">{stat.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Connection Hubs -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <SectionHeading
      title="Key Connection Hubs"
      subtitle="The most connected agents in the network — each manages the most direct reports."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {topHubs.map((hub, i) => (
        <a
          href={`/195_shades_of_agents-/agents/${hub.code.toLowerCase()}`}
          class="nexus-card p-5 group"
        >
          <div class="flex items-start justify-between mb-2">
            <span class="text-xs font-mono font-bold text-[var(--accent-text)] bg-[var(--accent-muted)] px-2 py-0.5 rounded">
              {hub.code}
            </span>
            <span class="text-xs font-mono text-[var(--text-muted)]">
              #{i + 1}
            </span>
          </div>
          <h4 class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-text)] transition-colors">
            {hub.role}
          </h4>
          <p class="text-xs text-[var(--text-muted)] mt-1">{hub.dept}</p>
          <div class="flex items-center gap-1.5 mt-3">
            <svg class="h-3.5 w-3.5 text-[var(--accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="text-sm font-bold text-[var(--text-primary)]">{hub.count} direct reports</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Department Sizes -->
  <section class="bg-[var(--bg-surface)] border-y border-[var(--border-color)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <SectionHeading
        title="Department Clustering"
        subtitle="Agent distribution across departments — larger departments form denser clusters in the graph."
      />

      <div class="space-y-3 max-w-3xl mx-auto">
        {deptSizes.map((dept: any) => {
          const pct = Math.round((dept.count / totalAgents) * 100);
          return (
            <a
              href={`/195_shades_of_agents-/departments/${departments.find((d: any) => d.number === dept.number)?.slug || ""}`}
              class="flex items-center gap-4 group hover:bg-[var(--bg-elevated)] rounded-lg px-3 py-2 -mx-3 transition-colors"
            >
              <span
                class="h-3 w-3 rounded-full flex-shrink-0"
                style={`background-color: ${dept.color}`}
              />
              <span class="text-sm text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors w-48 truncate">
                {dept.name}
              </span>
              <div class="flex-1 h-2 bg-[var(--bg-elevated)] rounded-full overflow-hidden">
                <div
                  class="h-full rounded-full transition-all"
                  style={`width: ${pct}%; background-color: ${dept.color};`}
                />
              </div>
              <span class="text-xs font-mono text-[var(--text-muted)] w-16 text-right">
                {dept.count} agents
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Controls & Interaction Guide -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <SectionHeading
      title="Interaction Guide"
      subtitle="Everything you need to navigate the network visualization."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        {
          title: "Navigate & Zoom",
          icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
          items: [
            "Scroll wheel to zoom in and out (0.3x to 4x)",
            "Click and drag on empty space to pan",
            "Double-click to focus on a region",
          ],
        },
        {
          title: "Explore Agents",
          icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
          items: [
            "Click any node to open the agent detail card",
            "The card shows code, role, department, and tier",
            "Click the profile link to visit their full page",
          ],
        },
        {
          title: "Highlight Connections",
          icon: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
          items: [
            "Hover over any node to highlight its department",
            "Same-department agents glow while others fade",
            "Reporting edges within the department brighten",
          ],
        },
        {
          title: "Drag Nodes",
          icon: "M7 11.5V14m0 0v2.5m0-2.5h2.5M7 14H4.5",
          items: [
            "Click and drag any agent node to reposition it",
            "The force simulation adjusts surrounding nodes",
            "Release to let the node settle into a new position",
          ],
        },
        {
          title: "Department Filter",
          icon: "M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z",
          items: [
            "Use the department legend to identify clusters",
            "Hover legend items to preview department nodes",
            "Click department links to visit department pages",
          ],
        },
        {
          title: "Performance",
          icon: "M13 10V3L4 14h7v7l9-11h-7z",
          items: [
            "SVG rendering handles 195 nodes efficiently",
            "Force simulation uses optimized D3.js physics",
            "Lazy-loaded: graph renders only when scrolled into view",
          ],
        },
      ].map((section) => (
        <div class="nexus-card p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="h-5 w-5 text-[var(--accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={section.icon} />
            </svg>
            <h4 class="text-sm font-semibold text-[var(--text-primary)]">{section.title}</h4>
          </div>
          <ul class="space-y-1.5">
            {section.items.map((item) => (
              <li class="flex items-start gap-2 text-xs text-[var(--text-secondary)]">
                <span class="text-[var(--accent-text)] mt-0.5">&#x2022;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Understanding the Graph -->
  <section class="bg-[var(--bg-surface)] border-y border-[var(--border-color)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <SectionHeading
        title="Understanding the Graph"
        subtitle="A primer on force-directed network visualization and what it reveals about NEXUS AI."
      />

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-3">Force-Directed Layout</h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            The graph uses a force-directed algorithm where connected agents attract each other
            while all agents repel slightly to avoid overlap. This naturally groups agents who
            share reporting chains, revealing the organizational hierarchy without manual positioning.
            Agents in the same department tend to cluster together because they share common managers.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-3">What Clusters Reveal</h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            Tight clusters indicate departments with deep internal hierarchies (like Engineering
            with 40 agents). Agents positioned between clusters are bridge roles — managers and
            executives who connect multiple departments. The CEO node naturally gravitates toward
            the center since all reporting chains ultimately flow through the C-Suite.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-3">Hierarchy Depth</h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            The organization spans 10 tier levels (0-9), from C-Suite executives down through
            VPs, Directors, Managers, and individual contributors, plus two special tiers for
            Governance gates and Special agents. Node size reflects this hierarchy — the largest
            nodes are the most senior leaders.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-3">Cross-Department Links</h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            While most edges stay within departments, some agents report to leaders in other
            departments — particularly at the VP and Director level where technical and business
            leadership intersect. These cross-cutting edges are what give the network its
            interconnected structure rather than isolated silos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: Explore More -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] mb-4">
      Go deeper into NEXUS AI
    </h2>
    <p class="text-lg text-[var(--text-secondary)] mb-8 max-w-xl mx-auto">
      The network is just one view. Explore individual agents, departments, and how they
      collaborate to deliver production software.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/195_shades_of_agents-/agents"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[var(--accent)] text-[var(--bg-primary)] font-semibold text-sm hover:opacity-90 transition-opacity"
      >
        Browse All Agents
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
      <a
        href="/195_shades_of_agents-/departments"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-[var(--border-color)] text-[var(--text-primary)] font-semibold text-sm hover:border-[var(--accent)] hover:text-[var(--accent-text)] transition-colors"
      >
