---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="Agent Network"
  description="Interactive visualization of NEXUS AI's 195 agents and their connections across 20 departments."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--text-primary)]">
        Agent <span class="text-gradient">Network</span>
      </h1>
      <p class="mt-4 text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
        Explore the connections between 195 agents across 20 departments.
        The network visualization shows reporting chains, cross-department
        interactions, and organizational structure.
      </p>
    </div>

    <!-- Network Graph placeholder — Sprint 3 will add the D3.js React island -->
    <div class="nexus-card nexus-glow p-8 md:p-12 text-center min-h-[400px] flex flex-col items-center justify-center">
      <div class="h-16 w-16 rounded-full bg-quantum-blue/10 flex items-center justify-center mb-6">
        <svg class="h-8 w-8 text-quantum-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
      </div>
      <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2">
        Interactive Network Visualization
      </h2>
      <p class="text-[var(--text-secondary)] max-w-md">
        The D3.js force-directed graph is coming in Sprint 3. It will display
        all 195 agents as nodes, with edges representing reporting chains and
        interaction frequencies.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/agents"
          class="inline-flex items-center px-4 py-2 rounded-lg bg-quantum-blue text-nexus-black font-semibold text-sm hover:bg-orbital-cyan transition-colors"
        >
          Browse Agents
        </a>
        <a
          href="/departments"
          class="inline-flex items-center px-4 py-2 rounded-lg border border-[var(--border-color)] text-[var(--text-primary)] text-sm hover:border-quantum-blue/50 transition-colors"
        >
          View Departments
        </a>
      </div>
    </div>
  </div>
</PageLayout>
