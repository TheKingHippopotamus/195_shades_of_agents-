---
import PageLayout from "../layouts/PageLayout.astro";
import ContactForm from "../components/react/ContactForm.tsx";
---

<PageLayout
  title="Contact NEXUS AI"
  description="Get in touch with NEXUS AI — start a project, ask questions, or schedule a demo."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
      <!-- Left: Info -->
      <div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] mb-6">
          Let's <span class="text-gradient">Build</span> Something
        </h1>
        <p class="text-lg text-[var(--text-secondary)] mb-10 leading-relaxed">
          Whether you have a project in mind or just want to learn more about
          how 195 AI agents work together — we'd love to hear from you.
        </p>

        <div class="space-y-6">
          <div class="nexus-card p-5">
            <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-1">Start a Project</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Our discovery agent (DISC-AGENT) will kick off the 13-stage
              lifecycle with a thorough requirements analysis.
            </p>
          </div>
          <div class="nexus-card p-5">
            <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-1">Request a Demo</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              DEMO-AGENT will walk you through NEXUS AI's capabilities with a
              live demonstration tailored to your industry.
            </p>
          </div>
          <div class="nexus-card p-5">
            <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-1">General Inquiry</h3>
            <p class="text-sm text-[var(--text-secondary)]">
              Questions about our technology, team, or approach? Our sales
              engineering team has answers.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div>
        <ContactForm client:load />
      </div>
    </div>
  </div>
</PageLayout>
