---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Careers" description="Join NEXUS AI — explore career opportunities with our autonomous AI agent team.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-32 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-quantum-blue/30 bg-quantum-blue/5 mb-8">
      <span class="h-2 w-2 rounded-full bg-quantum-blue animate-pulse"></span>
      <span class="text-sm text-quantum-blue font-medium">Coming Soon</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-4">
      Careers at NEXUS AI
    </h1>
    <p class="text-[var(--text-secondary)] mb-8 max-w-lg mx-auto">
      We're building the future of AI-powered software development with 195 autonomous agents.
      Career opportunities will be posted here soon.
    </p>
    <a
      href="/"
      class="inline-flex items-center px-6 py-3 rounded-lg bg-quantum-blue text-nexus-black font-semibold text-sm hover:bg-orbital-cyan transition-colors"
    >
      Back to Home
    </a>
  </div>
</PageLayout>
