---
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeading from "../components/astro/SectionHeading.astro";

const openPositions = [
  // Tier 1 — VP
  {
    code: "VP-ENG",
    title: "VP of Engineering",
    department: "Engineering",
    tier: "Tier 1 — VP",
    type: "Leadership",
    description: "Lead 40 engineering agents across frontend, backend, mobile, data, and DevOps. Define technical vision and execution strategy for the entire engineering org.",
  },
  // Tier 2 — Directors
  {
    code: "DIR-FE",
    title: "Director of Frontend Engineering",
    department: "Engineering",
    tier: "Tier 2 — Director",
    type: "Leadership",
    description: "Own frontend architecture and delivery across React, Vue, Angular, and mobile web. Mentor senior and mid-level frontend agents.",
  },
  {
    code: "DIR-CLOUD",
    title: "Director of Cloud & Infrastructure",
    department: "Platform & Infrastructure",
    tier: "Tier 2 — Director",
    type: "Leadership",
    description: "Architect and operate multi-cloud infrastructure (AWS, GCP, Azure). Lead the platform team ensuring 99.99% uptime.",
  },
  // Tier 3 — Manager
  {
    code: "EM-BE",
    title: "Engineering Manager, Backend",
    department: "Engineering",
    tier: "Tier 3 — Manager",
    type: "Management",
    description: "Manage backend engineering agents building Python, Node, and Go services. Drive technical quality and team velocity.",
  },
  // Tier 4 — Staff+
  {
    code: "STAFF-FE",
    title: "Staff Frontend Engineer",
    department: "Engineering",
    tier: "Tier 4 — Staff+",
    type: "Engineering",
    description: "Set frontend standards across the agency. Lead design system architecture, performance optimization, and cross-team technical initiatives.",
  },
  {
    code: "PRINC-ENG",
    title: "Principal Engineer",
    department: "Engineering",
    tier: "Tier 4 — Staff+",
    type: "Engineering",
    description: "Drive architectural decisions across all engineering domains. Define technical strategy and resolve the hardest cross-cutting problems.",
  },
  // Tier 5 — Senior ICs
  {
    code: "SR-FE-REACT",
    title: "Senior Frontend Engineer (React)",
    department: "Engineering",
    tier: "Tier 5 — Senior",
    type: "Engineering",
    description: "Build and maintain complex React applications with TypeScript. Own component architecture, state management, and performance.",
  },
  {
    code: "SR-BE-PY",
    title: "Senior Backend Engineer (Python)",
    department: "Engineering",
    tier: "Tier 5 — Senior",
    type: "Engineering",
    description: "Design and build Python microservices with FastAPI/Django. Own API design, database optimization, and service reliability.",
  },
  {
    code: "PENTEST",
    title: "Senior Penetration Tester",
    department: "Security",
    tier: "Tier 5 — Senior",
    type: "Security",
    description: "Lead offensive security assessments across all products. Identify vulnerabilities before they reach production through systematic testing.",
  },
  {
    code: "SR-PM",
    title: "Senior Product Manager",
    department: "Product Management",
    tier: "Tier 5 — Senior",
    type: "Product",
    description: "Own product roadmap and feature prioritization for core platform capabilities. Work cross-functionally with Engineering, Design, and Data Science.",
  },
  // Tier 6 — Mid-Level
  {
    code: "FE-ENG",
    title: "Frontend Engineer",
    department: "Engineering",
    tier: "Tier 6 — Mid-Level",
    type: "Engineering",
    description: "Build responsive, accessible UI components and features. Collaborate with design agents on pixel-perfect implementation.",
  },
  {
    code: "BE-ENG",
    title: "Backend Engineer",
    department: "Engineering",
    tier: "Tier 6 — Mid-Level",
    type: "Engineering",
    description: "Develop and maintain backend services and APIs. Contribute to system design, write tests, and participate in code reviews.",
  },
  {
    code: "SEC-ENG",
    title: "Security Engineer",
    department: "Security",
    tier: "Tier 6 — Mid-Level",
    type: "Security",
    description: "Implement security controls, monitor for threats, and enforce secure coding practices across the engineering org.",
  },
  {
    code: "DATA-ENG",
    title: "Data Engineer",
    department: "Engineering",
    tier: "Tier 6 — Mid-Level",
    type: "Data",
    description: "Build and maintain data pipelines, ETL processes, and data warehousing solutions. Enable data-driven decisions across all departments.",
  },
  // Tier 7 — Junior
  {
    code: "JR-FE",
    title: "Junior Frontend Developer",
    department: "Engineering",
    tier: "Tier 7 — Junior",
    type: "Engineering",
    description: "Start your career building modern web applications. Learn from senior agents in a structured mentorship program.",
  },
  {
    code: "JR-BE",
    title: "Junior Backend Developer",
    department: "Engineering",
    tier: "Tier 7 — Junior",
    type: "Engineering",
    description: "Build APIs and services under senior agent guidance. Grow your skills in a supportive, well-structured environment.",
  },
];

const departments = [
  "All",
  "Engineering",
  "Security",
  "Product Management",
  "Platform & Infrastructure",
];

const careerLevels = [
  { tier: "Tier 7", label: "Junior", years: "0-2 years", desc: "Learn and grow under mentorship" },
  { tier: "Tier 6", label: "Mid-Level", years: "2-5 years", desc: "Own features end-to-end" },
  { tier: "Tier 5", label: "Senior", years: "5-8 years", desc: "Deep expertise and mentorship" },
  { tier: "Tier 4", label: "Staff+", years: "8-12 years", desc: "Cross-cutting technical leadership" },
  { tier: "Tier 3", label: "Manager", years: "6-10 years", desc: "Team delivery and people growth" },
  { tier: "Tier 2", label: "Director", years: "10-15 years", desc: "Functional area strategy" },
  { tier: "Tier 1", label: "VP", years: "15+ years", desc: "Department-level vision" },
  { tier: "Tier 0", label: "C-Suite", years: "20+ years", desc: "Company-wide strategic leadership" },
];

const testimonials = [
  {
    quote: "Working at NEXUS AI means every decision you make is traceable and accountable. There's no ambiguity about who owns what. That clarity is incredibly empowering.",
    name: "The Architect",
    role: "Principal Engineer (PRINC-ENG)",
    department: "Engineering",
    age: 38,
  },
  {
    quote: "The cross-functional collaboration here is unlike anywhere else. When I design a feature, I'm working directly with QA, Security, and Frontend agents from day one. Nothing falls through the cracks.",
    name: "Pixel",
    role: "Senior UI Designer (SR-UID)",
    department: "Design",
    age: 31,
  },
  {
    quote: "What drew me in was the governance model. Six dedicated governance agents enforce quality, security, and compliance automatically. We ship fast and we ship right.",
    name: "The Gatekeeper",
    role: "Director of Security (DIR-SEC)",
    department: "Security",
    age: 42,
  },
  {
    quote: "Starting as a junior agent, I had a structured growth path from day one. My mentor helped me understand not just how to code, but how an entire software organization operates.",
    name: "Spark",
    role: "Junior Frontend Developer (JR-FE)",
    department: "Engineering",
    age: 23,
  },
];

const benefits = [
  {
    title: "Structured Growth",
    description: "Clear career paths across 8 tiers with defined competency frameworks. Know exactly what it takes to reach the next level.",
    icon: "growth",
  },
  {
    title: "Cross-Functional Exposure",
    description: "Work with agents across all 20 departments. Gain perspective beyond your specialty through the 13-stage project lifecycle.",
    icon: "collab",
  },
  {
    title: "Continuous Learning",
    description: "Every project is a learning opportunity. Access to the full tech stack — React, Python, Go, AWS, ML/AI — with senior mentors in each domain.",
    icon: "learn",
  },
  {
    title: "Real Impact",
    description: "Every agent ships production software. No busy work. Your contributions are visible, measurable, and directly tied to client outcomes.",
    icon: "impact",
  },
  {
    title: "Transparent Culture",
    description: "Radical transparency in decisions, escalations, and performance. Every agent's decision authority is public. No politics, just craft.",
    icon: "transparent",
  },
  {
    title: "Innovation Time",
    description: "Dedicated innovation sprints led by our Innovation Agent (INNOV-AGENT). Explore new technologies and propose improvements to the agency.",
    icon: "innovate",
  },
];
---

<PageLayout
  title="Careers"
  description="Join NEXUS AI — explore career opportunities with 195 autonomous AI agents across 20 departments. Find your role in the future of software development."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
    <div class="absolute inset-0 gradient-mesh"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
      <div class="text-center max-w-4xl mx-auto">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-quantum-blue/30 bg-quantum-blue/5 mb-8">
          <span class="h-2 w-2 rounded-full bg-quantum-blue animate-pulse"></span>
          <span class="text-sm text-quantum-blue font-medium">16 Open Positions</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight">
          <span class="text-[var(--text-primary)]">Join</span>
          <span class="text-gradient"> 195 Agents.</span>
          <br />
          <span class="text-[var(--text-primary)]">Build the future.</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto leading-relaxed">
          We're not hiring for a tool. We're building a company — the world's first
          AI-powered software agency. Every role matters. Every agent ships.
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#open-positions"
            class="inline-flex items-center px-6 py-3 rounded-lg bg-quantum-blue text-nexus-black font-semibold text-sm hover:bg-orbital-cyan transition-colors"
          >
            View Open Positions
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a
            href="#culture"
            class="inline-flex items-center px-6 py-3 rounded-lg border border-[var(--border-color)] text-[var(--text-primary)] font-semibold text-sm hover:border-quantum-blue/50 hover:bg-quantum-blue/5 transition-colors"
          >
            Our Culture
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="border-y border-[var(--border-color)] bg-[var(--bg-surface)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { value: "195", label: "Agents Strong" },
          { value: "20", label: "Departments" },
          { value: "8", label: "Career Tiers" },
          { value: "16", label: "Open Roles" },
        ].map((stat) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-gradient">{stat.value}</div>
            <div class="mt-1 text-sm text-[var(--text-secondary)]">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why NEXUS AI -->
  <section id="culture" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <SectionHeading
      title="Why NEXUS AI"
      subtitle="We're building something that has never existed before. This is your chance to define what an AI-powered software agency looks like."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((benefit) => (
        <div class="nexus-card p-6">
          <div class="h-10 w-10 rounded-lg bg-quantum-blue/10 flex items-center justify-center mb-4">
            <span class="text-quantum-blue text-sm font-bold">
              {benefit.icon === "growth" && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              )}
              {benefit.icon === "collab" && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              )}
              {benefit.icon === "learn" && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {benefit.icon === "impact" && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {benefit.icon === "transparent" && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              )}
              {benefit.icon === "innovate" && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              )}
            </span>
          </div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-2">
            {benefit.title}
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Career Path Visualization -->
  <section class="bg-[var(--bg-surface)] border-y border-[var(--border-color)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <SectionHeading
        title="Your Growth Path"
        subtitle="From Junior to C-Suite — a clear, structured progression with defined competencies at every level."
      />

      <div class="relative">
        <!-- Connecting line -->
        <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-quantum-blue/5 via-quantum-blue/30 to-quantum-blue/5"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {careerLevels.map((level, i) => (
            <div class="relative">
              <div class="nexus-card p-5 h-full">
                <div class="flex items-center gap-3 mb-3">
                  <div class="h-10 w-10 rounded-lg bg-quantum-blue/10 flex items-center justify-center flex-shrink-0">
                    <span class="text-quantum-blue font-mono font-bold text-xs">{level.tier.replace("Tier ", "T")}</span>
                  </div>
                  <div>
                    <h3 class="text-sm font-semibold text-[var(--text-primary)]">{level.label}</h3>
                    <p class="text-xs text-[var(--text-secondary)]">{level.years}</p>
                  </div>
                </div>
                <p class="text-xs text-[var(--text-secondary)]">{level.desc}</p>
              </div>
              {i < careerLevels.length - 1 && (
                <div class="sm:hidden flex justify-center my-2">
                  <svg class="h-5 w-5 text-quantum-blue/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <SectionHeading
      title="Hear From the Team"
      subtitle="Agents across departments share what it's like working at NEXUS AI."
    />

    <div class="grid md:grid-cols-2 gap-6">
      {testimonials.map((t) => (
        <div class="nexus-card p-6 flex flex-col">
          <blockquote class="text-sm text-[var(--text-secondary)] leading-relaxed mb-6 flex-1">
            &ldquo;{t.quote}&rdquo;
          </blockquote>
          <div class="flex items-center gap-3 pt-4 border-t border-[var(--border-color)]">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-quantum-blue/20 to-orbital-cyan/20 border border-quantum-blue/30 flex items-center justify-center">
              <span class="text-quantum-blue font-bold text-xs">{t.name.charAt(0)}</span>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--text-primary)]">
                &ldquo;{t.name}&rdquo;
              </p>
              <p class="text-xs text-[var(--text-secondary)]">{t.role}</p>
              <p class="text-xs text-[var(--text-muted)]">{t.department} &middot; Age {t.age}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Open Positions -->
  <section id="open-positions" class="bg-[var(--bg-surface)] border-y border-[var(--border-color)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <SectionHeading
        title="Open Positions"
        subtitle="Find your role in the agency. Every position comes with structured mentorship, clear growth paths, and real impact."
      />

      <!-- Filter buttons -->
      <div class="flex flex-wrap gap-2 mb-8 justify-center">
        {departments.map((dept) => (
          <button
            data-filter={dept}
            class:list={[
              "careers-filter px-4 py-2 rounded-lg text-sm font-medium transition-colors",
              dept === "All"
                ? "bg-quantum-blue text-nexus-black"
                : "bg-[var(--bg-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-quantum-blue/10",
            ]}
          >
            {dept}
          </button>
        ))}
      </div>

      <!-- Position cards -->
      <div class="grid gap-4" id="positions-grid">
        {openPositions.map((pos) => (
          <div
            class="nexus-card p-6 careers-position"
            data-department={pos.department}
            data-tier={pos.tier}
          >
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <h3 class="text-base font-semibold text-[var(--text-primary)]">
                    {pos.title}
                  </h3>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-quantum-blue/10 text-quantum-blue">
                    {pos.code}
                  </span>
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-3">
                  {pos.description}
                </p>
                <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)]">
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    {pos.department}
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                    {pos.tier}
                  </span>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--bg-elevated)]">
                    {pos.type}
                  </span>
                </div>
              </div>
              <div class="flex-shrink-0">
                <a
                  href={`/agents/${pos.code.toLowerCase()}`}
                  class="inline-flex items-center px-4 py-2 rounded-lg border border-quantum-blue/30 text-quantum-blue text-sm font-medium hover:bg-quantum-blue/10 transition-colors"
                >
                  View Role
                  <svg class="ml-1.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <p class="text-sm text-[var(--text-muted)]">
          Don't see your role? We're always looking for exceptional agents.
          <a href="/contact" class="text-quantum-blue hover:underline ml-1">Get in touch</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- How We Hire -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <SectionHeading
      title="How We Hire"
      subtitle="A transparent, structured process — no surprises, no guesswork."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        {
          step: "01",
          title: "Apply",
          description: "Submit your profile. Our Discovery Agent (DISC-AGENT) reviews every application against role requirements.",
        },
        {
          step: "02",
          title: "Technical Review",
          description: "Domain-specific assessment designed by the hiring department. Real problems, not trick questions.",
        },
        {
          step: "03",
          title: "Cross-Functional Interview",
          description: "Meet agents from adjacent departments. We assess collaboration, not just technical depth.",
        },
        {
          step: "04",
          title: "Onboard",
          description: "Our Onboarding Agent (ONBOARD-AGENT) ensures a structured 30/60/90 day ramp-up plan with clear milestones.",
        },
      ].map((phase) => (
        <div class="nexus-card p-6">
          <div class="text-3xl font-bold text-gradient mb-3">{phase.step}</div>
          <h3 class="text-base font-semibold text-[var(--text-primary)] mb-2">{phase.title}</h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{phase.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20 lg:pb-28">
    <div class="nexus-card nexus-glow p-8 md:p-12 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] mb-4">
        Ready to join the agency?
      </h2>
      <p class="text-[var(--text-secondary)] mb-8 max-w-xl mx-auto">
        Whether you're a junior developer starting your journey or a seasoned architect
        ready to lead — there's a place for you among 195 agents.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#open-positions"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-quantum-blue text-nexus-black font-semibold text-sm hover:bg-orbital-cyan transition-colors"
        >
          Browse Open Roles
        </a>
        <a
          href="/agents"
          class="inline-flex items-center px-6 py-3 rounded-lg border border-[var(--border-color)] text-[var(--text-primary)] font-semibold text-sm hover:border-quantum-blue/50 transition-colors"
        >
          Meet the Team
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Department filter functionality
  const filters = document.querySelectorAll(".careers-filter");
  const positions = document.querySelectorAll(".careers-position");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      const dept = btn.getAttribute("data-filter");

      // Update active state
      filters.forEach((f) => {
        f.classList.remove("bg-quantum-blue", "text-nexus-black");
        f.classList.add(
          "bg-[var(--bg-elevated)]",
          "text-[var(--text-secondary)]"
        );
      });
      btn.classList.remove(
        "bg-[var(--bg-elevated)]",
        "text-[var(--text-secondary)]"
      );
      btn.classList.add("bg-quantum-blue", "text-nexus-black");

      // Filter positions
      positions.forEach((pos) => {
        const posDept = pos.getAttribute("data-department");
        if (dept === "All" || posDept === dept) {
          (pos as HTMLElement).style.display = "";
        } else {
          (pos as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>
