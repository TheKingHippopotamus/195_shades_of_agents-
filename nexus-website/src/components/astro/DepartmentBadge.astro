---
interface Props {
  name: string;
  color: string;
  size?: "sm" | "md";
}

const { name, color, size = "sm" } = Astro.props;
const sizeClasses = size === "sm" ? "text-[10px] px-2 py-0.5" : "text-xs px-2.5 py-1";
---

<span
  class:list={["inline-flex items-center rounded-full font-medium", sizeClasses]}
  style={`background-color: ${color}15; color: ${color}; border: 1px solid ${color}30`}
>
  {name}
</span>
