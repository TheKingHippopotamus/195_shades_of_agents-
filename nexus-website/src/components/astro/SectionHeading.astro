---
interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}

const { title, subtitle, align = "center" } = Astro.props;
---

<div class:list={["mb-12", align === "center" && "text-center"]}>
  <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)]">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-4 text-lg text-[var(--text-secondary)] max-w-2xl mx-auto">
        {subtitle}
      </p>
    )
  }
</div>
