---
interface Props {
  code: string;
  name: string;
  role: string;
  department: string;
  departmentNumber: string;
  departmentColor: string;
  tierNumber: number;
  tierLabel: string;
  nickname?: string;
  avatarUrl?: string;
}

const {
  code,
  name,
  role,
  department,
  departmentNumber,
  departmentColor,
  tierNumber,
  tierLabel,
  nickname,
  avatarUrl,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Tier names for fallback avatars
const TIER_NAMES: Record<number, string> = {
  0: "csuite", 1: "vp", 2: "director", 3: "manager",
  4: "staff-plus", 5: "senior", 6: "mid", 7: "junior",
  8: "governance", 9: "special",
};

const agentAvatarSrc = `${base}/brand/avatars/agents/${code}.svg`;
const fallbackAvatarSrc = `${base}/brand/avatars/tier-${tierNumber}-${TIER_NAMES[tierNumber] || 'senior'}.svg`;
---

<a
  href={`${base}/agents/${code.toLowerCase()}/`}
  class="nexus-card p-4 block group"
>
  <div class="flex items-start gap-3">
    <!-- Agent Avatar (unique SVG face) -->
    <div class="flex-shrink-0">
      <img
        src={agentAvatarSrc}
        alt={`${nickname || code} avatar`}
        class="h-14 w-14 rounded-full"
        style={`border: 2px solid ${departmentColor}`}
        loading="lazy"
        width="56"
        height="56"
        onerror={`this.src='${fallbackAvatarSrc}'; this.onerror=null;`}
      />
    </div>

    <div class="flex-1 min-w-0">
      <!-- Code + Tier -->
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-mono font-semibold text-quantum-blue">
          {code}
        </span>
        <span
          class="text-[10px] px-1.5 py-0.5 rounded-full font-medium"
          style={`background-color: ${departmentColor}20; color: ${departmentColor}`}
        >
          T{tierNumber}
        </span>
      </div>

      <!-- Role -->
      <h3
        class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-quantum-blue transition-colors truncate"
      >
        {role}
      </h3>

      <!-- Department -->
      <p class="text-xs text-[var(--text-secondary)] truncate mt-0.5">
        {department}
      </p>

      <!-- Nickname -->
      {
        nickname && (
          <p class="text-xs text-[var(--text-secondary)] italic mt-1">
            &ldquo;{nickname}&rdquo;
          </p>
        )
      }
    </div>
  </div>
</a>
