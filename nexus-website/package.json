{
  "name": "nexus-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npx tsx scripts/build-agent-data.ts && npx tsx scripts/fetch-sanity-content.ts",
    "dev": "astro dev",
    "build": "npm run prebuild && astro build && npx tsx scripts/generate-sitemap.ts && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.2",
    "@nanostores/react": "^0.8.0",
    "astro": "^4.16.0",
    "d3": "^7.9.0",
    "dompurify": "^3.3.1",
    "framer-motion": "^11.15.0",
    "glob": "^11.0.0",
    "marked": "^17.0.2",
    "nanostores": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "pagefind": "^1.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
