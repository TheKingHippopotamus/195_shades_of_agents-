{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS Knowledge Base Record",
  "description": "Schema for a single document record in the NEXUS Knowledge Base ML dataset",
  "type": "object",
  "required": [
    "doc_id",
    "source_path",
    "category",
    "subcategory",
    "title",
    "content_full",
    "content_chunks",
    "metadata",
    "tags",
    "entity_type",
    "token_count",
    "embedding_ready_text",
    "created_at_epoch",
    "nexus_relevance_score"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "description": "Unique slug identifier, e.g. arch-overview-001",
      "pattern": "^[a-z0-9-]+-[0-9]{3}$"
    },
    "source_path": {
      "type": "string",
      "description": "Absolute path to the original source file"
    },
    "category": {
      "type": "string",
      "description": "Primary classification",
      "enum": [
        "architecture",
        "api",
        "security",
        "operations",
        "development",
        "setup",
        "deployment",
        "user-guide",
        "archive",
        "summary"
      ]
    },
    "subcategory": {
      "type": "string",
      "description": "More specific classification within the category"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "content_full": {
      "type": "string",
      "description": "Full document text"
    },
    "content_chunks": {
      "type": "array",
      "description": "Array of ~500-word text segments for chunked retrieval",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "description": "Structured metadata about the document",
      "required": [
        "author",
        "date",
        "department",
        "what",
        "who",
        "when"
      ],
      "properties": {
        "author": {
          "type": "string",
          "description": "Extracted author or department"
        },
        "date": {
          "type": "string",
          "description": "ISO date format YYYY-MM-DD",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "department": {
          "type": "string",
          "description": "NEXUS department (CISO, CTO, CPO, etc.)"
        },
        "what": {
          "type": "string",
          "description": "One-sentence summary of what this document covers"
        },
        "who": {
          "type": "string",
          "description": "Who created or owns this document"
        },
        "when": {
          "type": "string",
          "description": "When this was created or last updated"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "description": "Array of keyword tags for search and filtering",
      "items": {
        "type": "string"
      }
    },
    "entity_type": {
      "type": "string",
      "description": "Same as category",
      "enum": [
        "architecture",
        "api",
        "security",
        "operations",
        "development",
        "setup",
        "deployment",
        "user-guide",
        "archive",
        "summary"
      ]
    },
    "token_count": {
      "type": "integer",
      "description": "Estimated token count of the full content",
      "minimum": 0
    },
    "embedding_ready_text": {
      "type": "string",
      "description": "Title + first paragraph + key headers for vector embedding"
    },
    "created_at_epoch": {
      "type": "integer",
      "description": "Unix timestamp of record creation"
    },
    "nexus_relevance_score": {
      "type": "number",
      "description": "Relevance score from 0.0 to 1.0",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "additionalProperties": false
}
